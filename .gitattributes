# Keep LF endings everywhere. Shell scripts, Dockerfiles and Caddyfile MUST be
# LF or they break when they run on Linux / inside containers.
* text=auto eol=lf

*.sh        text eol=lf
Dockerfile  text eol=lf
*.Dockerfile text eol=lf
Caddyfile   text eol=lf
*.png binary
*.jpg binary
*.ico binary
*.woff2 binary
