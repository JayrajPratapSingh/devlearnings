# ─────────────────────────────────────────────────────────────────────────────
# DevPrep IDE — copy this file to .env and fill in real values.
# .env is gitignored. Never commit real secrets.
#
#   cp .env.example .env
#
# Generate a secret:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ─────────────────────────────────────────────────────────────────────────────

# ── PostgreSQL (docker compose up -d postgres brings this up) ────────────────
POSTGRES_USER=devprep
POSTGRES_PASSWORD=change-me
POSTGRES_DB=devprep
# 5433 on the host so it never clashes with a Postgres you already run on 5432
POSTGRES_PORT=5433

DATABASE_URL="postgresql://devprep:change-me@localhost:5433/devprep?schema=public"

# ── API server ───────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
CLIENT_ORIGIN=http://localhost:5173

# Must be at least 16 characters. Use two DIFFERENT random values.
JWT_ACCESS_SECRET=replace-with-a-32-byte-random-hex-string
JWT_REFRESH_SECRET=replace-with-a-different-32-byte-random-hex-string
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30

# ── Execution service ────────────────────────────────────────────────────────
EXECUTION_SERVICE_URL=http://localhost:4001
EXECUTION_PORT=4001
# Shared secret between the API and the execution service. Not a user-facing key.
EXECUTION_SERVICE_TOKEN=replace-with-a-random-token

# docker = real container isolation (required for anything but local dev)
# local  = spawn the runtime on this host. NO ISOLATION. Development only.
SANDBOX_DRIVER=docker

# Per-execution limits
EXECUTION_TIMEOUT_MS=5000
MEMORY_LIMIT_MB=256
CPU_LIMIT=0.5
MAX_CONCURRENT_EXECUTIONS=4
EXECUTION_MAX_OUTPUT_BYTES=64000
MAX_CODE_LENGTH=50000

# ── Password reset delivery ──────────────────────────────────────────────────
# console = no account needed. The 6-digit code is printed to the server log and
#           shown in the UI (development only), so the whole flow works today.
# twilio  = real SMS worldwide.
# msg91   = real SMS for Indian numbers. Needs DLT-approved sender + template.
SMS_PROVIDER=console
RESET_CODE_TTL_MINUTES=10
RESET_MAX_ATTEMPTS=5

# Only needed when SMS_PROVIDER=twilio
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=+1234567890

# Only needed when SMS_PROVIDER=msg91
# MSG91_AUTH_KEY=
# MSG91_TEMPLATE_ID=

# ── Frontend (Vite only exposes VITE_* to the browser) ───────────────────────
VITE_API_URL=http://localhost:4000/api
