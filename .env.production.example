# ─────────────────────────────────────────────────────────────────────────────
# Production environment for docker-compose.prod.yml
#
#   cp .env.production.example .env.production      # then fill in real values
#
# This file holds SECRETS. It is gitignored. Never commit the filled-in version.
# On the server it lives at /opt/devprep/.env.production (see DEPLOYMENT.md).
#
# Generate each secret with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ─────────────────────────────────────────────────────────────────────────────

# ── Where the app is served ─────────────────────────────────────────────────
# Start with :80 (plain HTTP, reach it by the EC2 public IP). Once you own a
# domain and its DNS points at the server, change BOTH lines to your domain.
SITE_ADDRESS=:80
CLIENT_ORIGIN=http://REPLACE_WITH_EC2_PUBLIC_IP
#   With a domain, instead:
#   SITE_ADDRESS=devprep.example.com
#   CLIENT_ORIGIN=https://devprep.example.com
ACME_EMAIL=you@example.com

# ── PostgreSQL (runs as a container; data lives in the `pgdata` volume) ──────
POSTGRES_USER=devprep
POSTGRES_PASSWORD=CHANGE_ME_long_random_password
POSTGRES_DB=devprep

# ── API secrets — must be two DIFFERENT 32-byte random hex strings ───────────
JWT_ACCESS_SECRET=CHANGE_ME_generate_a_32_byte_hex
JWT_REFRESH_SECRET=CHANGE_ME_generate_a_DIFFERENT_32_byte_hex
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30

# Password-reset codes: 'console' prints them to the server log (fine to start).
SMS_PROVIDER=console

# ── Container image source ──────────────────────────────────────────────────
# Local build (docker compose ... up --build): leave these unset.
# On the server (images pushed by GitHub Actions): the deploy workflow writes
# REGISTRY and TAG for you. Example:
#   REGISTRY=ghcr.io/your-github-username
#   TAG=latest

# ── Code execution service ──────────────────────────────────────────────────
# Not deployed yet. Leave commented until you add it.
# EXECUTION_SERVICE_URL=http://execution-service:4001
# EXECUTION_SERVICE_TOKEN=CHANGE_ME_random_token
